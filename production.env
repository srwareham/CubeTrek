# This file contains the environment variables you probably don't need to set
# Configure how CubeTrek emails you
SPRING_MAIL_USERNAME=your_email_username
SPRING_MAIL_PASSWORD=your_email_password
SPRING_MAIL_PROPERTIES_MAIL_SMTP_FROM=registration@mail.cubetrek.com
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=587

# Configure APIs. Note you must get your own keys to use these
CLOUDFLARE_TURNSTYLE_SECRET=your_cloudflare_secret
GARMIN_CONSUMER_KEY=your_garmin_consumer_key
GARMIN_CONSUMER_SECRET=your_garmin_consumer_secret
POLAR_CLIENT_ID=your_polar_client_id
POLAR_CLIENT_SECRET=your_polar_client_secret
POLAR_WEBHOOK_SIGNATURE_SECRET_KEY=your_polar_webhook_secret
POLAR_WEBHOOK_ID=your_polar_webhook_id
SUUNTO_CLIENT_ID=your_suunto_client_id
SUUNTO_PRIMARY_KEY=your_suunto_primary_key
SUUNTO_CLIENT_SECRET=your_suunto_client_secret
THIRDPARTY_CLIENTKEY_KEY=your_thirdparty_clientkey
STRIPE_CONTROLLER_ENABLED=false
STRIPE_API_KEY=your_stripe_api_key
STRIPE_PRICE=your_stripe_price
STRIPE_ENDPOINT_SECRET=your_stripe_endpoint_secret
STRIPE_ENDPOINT_PUBLIC=your_stripe_endpoint_public
COROS_CLIENT_ID=your_coros_client_id
COROS_CLIENT_SECRET=your_coros_client_id

POSTGRES_DB=cubetrek
POSTGRES_USER=cubetrek_postgres
POSTGRES_PASSWORD=ykhQ4XQCx>7_7,>=Sd5,uZWkv-~T

SPRING_DATASOURCE_USERNAME=${POSTGRES_USER}
SPRING_DATASOURCE_PASSWORD=${POSTGRES_PASSWORD}